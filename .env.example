# --- Core ---
PORT=5000
NODE_ENV=development
JWT_SECRET=change_me

DB_HOST=localhost
DB_NAME=formforge_db
DB_USER=root
DB_PASS=

# --- Subscription auto-create: Google Play ---
# 1) Play Console → Setup → API access → link Google Cloud project
# 2) Create service account → grant "Manage orders and subscriptions" on the app
# 3) Download JSON key (paste full JSON below OR set path)
GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.yourapp
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=./secrets/google-play-service-account.json
GOOGLE_PLAY_REGIONS_VERSION=2022/02
# Must match your app's default language in Play Console (e.g. en-GB, en-US)
GOOGLE_PLAY_DEFAULT_LANGUAGE=en-GB
# Optional: comma-separated extra listing languages
# GOOGLE_PLAY_LISTING_LANGUAGES=en-GB,en-US
GOOGLE_PLAY_DEFAULT_REGION=US
GOOGLE_PLAY_BASE_PLAN_ID=default
GOOGLE_PLAY_AUTO_ACTIVATE=true
DEFAULT_SUBSCRIPTION_BILLING_PERIOD=P1M

# --- Subscription auto-create: Apple App Store Connect ---
# Users and Access → Keys → App Store Connect API (Admin or App Manager)
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXX.p8
# App Store Connect → Apps → your app → App Information → Apple ID (numeric)
APPLE_APP_ID=
# Subscriptions → Subscription Group → copy Group ID from URL, OR auto-create:
APPLE_SUBSCRIPTION_GROUP_ID=
APPLE_AUTO_CREATE_SUBSCRIPTION_GROUP=false
APPLE_SUBSCRIPTION_GROUP_REFERENCE_NAME=FormForge Subscriptions
APPLE_SUBSCRIPTION_PRODUCT_ID_PREFIX=com.yourcompany.yourapp
# Auto-set localization + price + availability after create (or use admin ⋮ menu)
APPLE_AUTO_COMPLETE_METADATA=true
APPLE_DEFAULT_LOCALE=en-US
APPLE_DEFAULT_TERRITORY=USA
# Display name for the subscription group (required by Apple for MISSING_METADATA)
APPLE_SUBSCRIPTION_GROUP_DISPLAY_NAME=FormForge Premium
# iPhone app screenshot for subscription review (e.g. 1284x2778 portrait PNG/JPG)
# APPLE_SUBSCRIPTION_REVIEW_SCREENSHOT_PATH=./assets/subscription-review-screenshot.png
